            "stale_claim",
            "incomplete_read",
            "stale_binding",
            "uncertain_outcome",
            "already_complete",
            "superseded",
            "out_of_order",
            "paused_or_revoked",
            "record_only"
          ]
        },
        "next": {"const": "end"},
        "effects": {"const": []}
      }
    },
