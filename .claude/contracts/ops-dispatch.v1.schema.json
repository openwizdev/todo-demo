            "additionalProperties": false,
            "properties": {
              "operation_key": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
              "decision": {
                "type": "string",
                "enum": ["granted", "refused", "uncertain", "revoked", "completed", "replaced"]
              },
              "grant_id": {
                "oneOf": [{"type": "string", "pattern": "^[a-z][a-z0-9-]*$(?![\\s\\S])", "maxLength": 80}, {"type": "null"}]
              },
              "final_diff_digest": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"}, {"type": "null"}]},
              "remediation": {"type": "string", "enum": ["none", "revoke_and_hold", "escalate"]}
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["schema", "kind", "operation_key", "intent_id", "state", "reason", "next", "effects"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "openwiz.ops-dispatch.v1"},
        "kind": {"const": "result"},
        "operation_key": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
