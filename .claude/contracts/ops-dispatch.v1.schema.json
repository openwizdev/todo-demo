        "ticket": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "approval": {"$ref": "#/$defs/approval"},
        "head": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"}, {"type": "null"}]},
        "generation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "owner": {"oneOf": [{"type": "string", "pattern": "^[a-z][a-z0-9-]*$(?![\\s\\S])", "maxLength": 80}, {"type": "null"}]},
        "complete": {"type": "boolean"},
        "uncertain_keys": {"type": "array", "minItems": 0, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"}},
        "paused": {"type": "boolean"},
        "revoked": {"type": "boolean"},
        "holds": {
          "type": "array",
          "minItems": 0,
          "items": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
        },
        "gates": {"type": "array", "minItems": 0, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "cutoff": {"type": "string", "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"},
        "history_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
        "next_sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "recipient_verified": {"type": "boolean"},
